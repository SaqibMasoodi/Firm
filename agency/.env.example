# Northforge Labs — Environment Variables
# Copy this file to .env.local and fill in the values.

# Site URL (used for canonical URLs, OG tags, sitemaps)
NEXT_PUBLIC_SITE_URL=https://firm-khaki.vercel.app

# Contact enquiries — server-only; never prefix these with NEXT_PUBLIC_
RESEND_API_KEY=
# Use a sender on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=
# Optional: defaults to the contact email in Admin > Site Settings.
# CONTACT_TO_EMAIL=masudisaqib1@gmail.com

# Newsletter (Mailchimp, ConvertKit, etc.)
# NEWSLETTER_API_KEY=
# NEWSLETTER_LIST_ID=

# Analytics (Google Analytics, Plausible, etc.)
# NEXT_PUBLIC_GA_ID=
