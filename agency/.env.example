# Northforge Labs — Environment Variables
# Copy this file to .env.local and fill in the values.

# Site URL (used for canonical URLs, OG tags, sitemaps)
NEXT_PUBLIC_SITE_URL=https://northforgelabs.com

# Contact Form (email provider credentials, if using)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=contact@northforgelabs.com

# Newsletter (Mailchimp, ConvertKit, etc.)
# NEWSLETTER_API_KEY=
# NEWSLETTER_LIST_ID=

# Analytics (Google Analytics, Plausible, etc.)
# NEXT_PUBLIC_GA_ID=
